<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use versions compatible with Fable 4.24.0 (adjust if your dotnet fable shows a different compiler version) -->
    <PackageReference Include="Fable.Core" Version="3.7.1" />
    <PackageReference Include="Fable.SimpleJson" Version="3.24.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only include the minimal files needed by the test runner -->
    <Compile Include="..\NearleyBindings.fs" />
    <Compile Include="..\TestParser.fs" />
  </ItemGroup>
  <Import Project="..\..\..\..\.paket\Paket.Restore.targets" />
</Project>