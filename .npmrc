# Don't run the automatic audit after every install/ci - it is noise at a moment
# when nobody is deciding anything. The gate is `npm run audit`, which runs
# automatically before `npm run dist` via the predist hook.
#
# That gate audits everything, dev dependencies included. It used to be limited
# to production ones, on the reasoning that only they ship - but Electron itself
# is a devDependency, and has to be, because that is where electron-builder
# expects it. Restricting the audit to production dependencies therefore could
# not see an Electron advisory, which is the single most important kind for an
# app whose renderer is a browser.
#
# The cost is real: most of what a full audit reports is build tooling that
# never reaches a user, and historically the bulk of the count has been one
# brace-expansion advisory whose range ("<=5.0.7") over-matches the 1.x and 2.x
# lines and so flags copies that are already the newest of their line. Read the
# output rather than counting it.
audit=false

# Commit and tag message for `npm version` releases (%s is the new version).
message=Release v%s
