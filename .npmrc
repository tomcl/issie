# Don't run the automatic audit after every install/ci.
#
# The combined dev+prod count it prints is misleading here: nearly all of it is
# build-tooling that never ships, and the bulk is a single brace-expansion
# advisory whose range ("<=5.0.7") over-matches the 1.x and 2.x lines, so it
# flags copies that are already the newest published release of their line.
#
# What actually matters is production dependencies, which ship to users. That is
# checked explicitly by `npm run audit:prod`, and runs automatically before
# `npm run dist` via the predist hook.
audit=false
