<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Renderer\Common\ElectronAPI.fs" Link="ElectronAPI.fs" />
    <!-- Shared with the renderer, and needed here because ContextMenus.fs is shared too and
         logs. It also puts both processes on one clock: Log stamps process.uptime(), which is
         what Main.stampStartup prints. window.issieLog is a renderer thing and publish() is
         simply never called here. -->
    <Compile Include="..\Renderer\Common\Log.fs" Link="Log.fs" />
    <!-- The `electron` module itself. Only this project: ElectronAPI.fs above is shared for its
         types, and importing the module from the renderer is what contextIsolation forbids. -->
    <Compile Include="ElectronModule.fs" />
    <Compile Include="..\Renderer\UI\ContextMenus.fs" Link="ContextMenus.fs" />
    <!-- The half of the context menus that builds an Electron menu, split out for the same reason -->
    <Compile Include="ContextMenuBuilder.fs" />
    <Compile Include="Bridge.fs" />
    <Compile Include="Main.fs" />
    <None Include="main.js" />
  </ItemGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/tomcl/issie</RepositoryUrl>
    <FsDocsReleaseNotesLink>https://github.com/tomcl/issie/releases/</FsDocsReleaseNotesLink>
    <FsDocsLicenseLink>https://github.com/tomcl/issie/blob/master/LICENSE.md</FsDocsLicenseLink>
    <FsDocsLogoSource>/issieIcon.png</FsDocsLogoSource>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>